{
  "ws_url": "ws://127.0.0.1:3001",
  "onebot_token": "<NapCat OneBot token>",
  "codex_path": "/home/<user>/.local/bin/codex",
  "owner_qq": "<主人 QQ>",
  "private_whitelist": [],
  "allow_all_groups": true,
  "allowed_groups": [],
  "group_user_blacklist": [],
  "mention_qq": [],
  "show_tool_progress": false,
  "voice": {
    "enabled": false,
    "mode": "reply",
    "group_enabled": false,
    "group_voice_only": false,
    "private_voice_only": false,
    "preload": true,
    "timeout_seconds": 120,
    "command": [
      "/home/<user>/.local/share/aemeath-voice/venv/bin/python",
      "-u",
      "/path/to/voyaging-star/tools/voice_backend.py",
      "--model-dir",
      "/home/<user>/.local/share/aemeath-voice/model/ONNX_aimisiV2"
    ]
  },
  "agents": {
    "front": "codex",
    "guest": "codex",
    "profiles": {
      "codex": {
        "type": "codex_app"
      }
    }
  }
}
